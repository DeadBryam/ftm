<div class="ftm-dashboard">
  <header class="ftm-header">
    <h2><i class="fas fa-network-wired"></i> {{localize "FTM_TITLE"}}</h2>
    <div class="ftm-status {{#if connected}}ftm-ok{{else}}ftm-off{{/if}}">
      {{#if connected}}
        <i class="fas fa-circle"></i> {{localize "FTM_TUNNEL"}}
      {{else}}
        <i class="fas fa-circle-xmark"></i> offline
      {{/if}}
    </div>
  </header>

  <section class="ftm-frame-wrapper">
    {{#if connected}}
      <iframe src="{{apiBase}}" title="FTM Dashboard"></iframe>
    {{else}}
      <div class="ftm-empty">
        <p>ftm server is not running.</p>
        <button data-action="start"><i class="fas fa-play"></i> {{localize "FTM_STARTING"}}</button>
        <button data-action="refresh"><i class="fas fa-rotate"></i> Refresh</button>
      </div>
    {{/if}}
  </section>

  {{#if connected}}
  <footer class="ftm-footer">
    <span>API: <a href="{{apiBase}}" target="_blank">{{apiBase}}</a></span>
    <button data-action="stop"><i class="fas fa-stop"></i> Stop</button>
    <button data-action="refresh"><i class="fas fa-rotate"></i> Refresh</button>
  </footer>
  {{/if}}
</div>
